NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (GOOGLE_CLIENT_SECRET is unused by the current ID-token flow, but
# Google Cloud Console issues one regardless — safe to leave blank or fill in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeather
OPENWEATHER_API_KEY=

# Firebase Cloud Messaging (push notifications - scaffold only)
FIREBASE_SERVER_KEY=
