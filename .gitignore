# Dependencies
node_modules/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/
build/

# Logs
backend/logs/*
!backend/logs/.gitkeep
*.log
npm-debug.log*

# Uploads (local dev only; production uses Cloudinary)
backend/uploads/*
!backend/uploads/.gitkeep

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo
